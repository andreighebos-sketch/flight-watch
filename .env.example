# ---------------------------------------------------------------------------
# Flight Watch configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Which flight-data provider to use: serpapi | duffel | demo
#   serpapi -> live Google Flights results via SerpApi (recommended, self-serve key)
#   duffel  -> Duffel Flights API (duffel_test_ token = SANDBOX data, duffel_live_ = live)
#   demo    -> clearly labelled DEMO DATA for UI development, never real fares
FLIGHT_PROVIDER=serpapi

# SerpApi key: https://serpapi.com/users/sign_up -> https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Google country (point of sale) and language used for the search
SERPAPI_GL=md
SERPAPI_HL=en
# true = slower but identical to the browser results on Google Flights
SERPAPI_DEEP_SEARCH=false

# Duffel access token: https://app.duffel.com -> Developers -> Access tokens
DUFFEL_ACCESS_TOKEN=
# Max connections per slice sent to Duffel (Duffel default is 1; 2 widens the search)
DUFFEL_MAX_CONNECTIONS=2
DUFFEL_SUPPLIER_TIMEOUT_MS=20000

# Server
PORT=3000
HOST=127.0.0.1

# Monitoring (leave empty to use provider-specific defaults, see README)
REFRESH_INTERVAL_MINUTES=
CACHE_TTL_MINUTES=
AUTO_REFRESH=true
MANUAL_REFRESH_COOLDOWN_SECONDS=60
# Hard cap of provider requests per UTC day (0 = no cap). Protects your SerpApi quota.
DAILY_REQUEST_LIMIT=
MAX_OFFERS_PER_DATE=25
REQUEST_TIMEOUT_MS=60000

# SQLite file (created automatically)
DB_PATH=./data/flight-watch.sqlite
